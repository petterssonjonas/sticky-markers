{
  "app-id": "dev.stickymarkers.desktop",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "sticky-markers",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--env=LD_LIBRARY_PATH=/app/lib",
    "--env=WEBKIT_INJECTED_BUNDLE_PATH=/app/lib/webkit2gtk-4.1/injected-bundle"
  ],
  "modules": [
    {
      "name": "sticky-markers",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a bin lib share /app/"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "payload"
        }
      ]
    }
  ]
}
