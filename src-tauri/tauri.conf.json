{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticky Markers",
  "version": "0.1.0",
  "identifier": "dev.stickymarkers.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/prepare-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Markdown notes, one little window at a time.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux.desktop.hbs",
        "files": {
          "/usr/share/applications/dev.stickymarkers.desktop.desktop": "../packaging/linux/dev.stickymarkers.desktop.desktop"
        }
      },
      "rpm": {
        "release": "5",
        "desktopTemplate": "linux.desktop.hbs",
        "files": {
          "/usr/share/applications/dev.stickymarkers.desktop.desktop": "../packaging/linux/dev.stickymarkers.desktop.desktop"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5OUIxQzk5OTAxRDlFQzgKUldUSW5oMlFtUnliaVdtdHNpYldxazEyRlZxSFdBTFhka1hWZmUxOXpqTzgwOFdnL2RySEZXVGMK"
    }
  }
}
