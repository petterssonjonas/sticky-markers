{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Sticky Markers application windows",
  "windows": ["main", "note-*", "rename-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-url"
  ]
}
