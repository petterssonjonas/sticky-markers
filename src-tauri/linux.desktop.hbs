[Desktop Entry]
Type=Application
Name={{name}}
Comment={{comment}}
Exec={{exec}}
Icon={{icon}}
Terminal=false
Categories={{categories}}
StartupWMClass=dev.stickymarkers.desktop
NoDisplay=true
X-StickyMarkers-Owned=true
Actions=Main;New;

[Desktop Action Main]
Name=Open Main Window
Exec={{exec}} --main

[Desktop Action New]
Name=New Note
Exec={{exec}}
